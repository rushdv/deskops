# ==============================================================================
# DeskOps Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
# NOTE: Do NOT commit .env containing real credentials or secrets to Git.

# --- Server Configuration ---
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# --- Database (PostgreSQL Infrastructure) ---
POSTGRES_USER=deskops
POSTGRES_PASSWORD=deskops_password
POSTGRES_DB=deskops_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://deskops:deskops_password@localhost:5432/deskops_db?schema=public

# --- Redis (Infrastructure placeholder for queue & cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Authentication & Secrets (Placeholders for future stages) ---
JWT_ACCESS_SECRET=replace_with_a_secure_jwt_access_secret_in_env
JWT_REFRESH_SECRET=replace_with_a_secure_jwt_refresh_secret_in_env
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- S3 / Storage Configuration (Placeholders for future stages) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=deskops-attachments
S3_ACCESS_KEY=placeholder_access_key
S3_SECRET_KEY=placeholder_secret_key

# --- Inbound Email Webhook (Placeholders for future stages) ---
EMAIL_WEBHOOK_SECRET=placeholder_email_webhook_secret
